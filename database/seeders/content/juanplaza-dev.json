    "request-path": {
        "type": "diagram",
        "title": "Request path for juanplaza.dev",
        "description": "A browser requests the site over HTTPS. Caddy terminates TLS and reverse-proxies to the juanplaza container on port 8080 over a shared Docker network. That container runs Laravel on Octane and FrankenPHP, with the Inertia SSR process alongside it on loopback port 13714. Postgres sits on a second Docker network that Caddy has no route to. Separately, the browser calls the Open-Meteo forecast API directly, without passing through the server.",
        "width": 560,
        "height": 400,
        "caption": "One container, reached by name, with the database on a network the proxy cannot see. The only other network call leaves the browser and never touches the box.",
        "groups": [
            {
