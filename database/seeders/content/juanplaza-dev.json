    "deploy-pipeline": {
        "type": "diagram",
        "title": "Deploy pipeline",
        "description": "A push to the production branch runs the ci workflow on GitHub's runners. Only a green run triggers the deploy, which executes on a self-hosted runner on the VPS itself. That runner builds the image, pushes it to GHCR tagged with both the commit SHA and latest, brings the stack up, runs migrations, then caches the framework config and reloads Octane so the workers pick it up.",
        "width": 560,
        "height": 250,
        "minWidth": 520,
        "caption": "The runner is the box it deploys to, so nothing crosses the network at deploy time. GHCR is for history and rollback, not for the deploy path.",
