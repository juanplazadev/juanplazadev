# Single source of truth for ports and URLs, shared by compose.yaml,
# compose.prod.yaml and frontend/vite.config.ts (which points its envDir here).
# Copy to .env and adjust as needed:  cp .env.example .env

# Port the app itself listens on: `npm run preview`, the nginx prod container,
# and later the Spring Boot service. Caddy reverse-proxies to this in prod.
APP_PORT=8080

# Vite dev server. Not 5173 - that one is claimed by ibiri-laravel.test-1.
VITE_PORT=5180

# Where Vite forwards /api during development. Inert until backend/ exists.
#   host machine      -> http://localhost:8080
#   dev container     -> http://host.docker.internal:8080   (set in compose.yaml)
#   backend service   -> http://api:8080                    (once it is a compose service)
VITE_API_PROXY_TARGET=http://localhost:8080

# Hero weather pill. Open-Meteo is keyless and CORS-open, so the browser calls
# it directly - this is the first live request the app makes, and the only
# thing that changes when the Spring Boot API proxies it is the URL below.
# Shelton, CT 06484. Blank or non-numeric coordinates disable the pill's
# weather rather than reporting some other place's sky.
VITE_WEATHER_LATITUDE=41.3165
VITE_WEATHER_LONGITUDE=-73.0932
VITE_WEATHER_TIMEZONE=America/New_York
VITE_WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
