# Copy to .env and adjust as needed:  cp .env.example .env
#
# Also the source of truth for the ports compose.yaml and compose.prod.yaml use,
# and for the VITE_* values the frontend build reads.

APP_NAME="Juan Plaza"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_PORT=8080
APP_SERVICE=juanplazadev

# Availability signalling on the landing page: the hero status dot, the "Open to
# remote roles" badge, and the first clause of the Contact card. The work
# history, stats and resume button ignore it. Octane reads config once per
# worker, so flipping this needs a container restart - it is not a live toggle.
SITE_HIRING_MODE=false

VITE_API_PROXY_TARGET=http://localhost:8080
VITE_WEATHER_LATITUDE=41.3165
VITE_WEATHER_LONGITUDE=-73.0932
VITE_WEATHER_TIMEZONE=America/New_York
VITE_WEATHER_API_URL=https://api.open-meteo.com/v1/forecast

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production only. Local is plain HTTP, so setting this here would make the
# browser drop the session cookie entirely; prod sits behind Caddy over TLS and
# pins it to true rather than inferring it from the forwarded scheme.
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# The Mailpit web UI, published by compose.yaml on 8025. Also what puts Mailpit
# in the panel's Consoles menu: leave it unset outside local and no link is
# rendered.
MAILPIT_URL=http://localhost:8025

# Mailgun sends the résumé email in production; local stays on Mailpit.
# MAILGUN_SECRET is the sending API key. MAILGUN_WEBHOOK_SIGNING_KEY is a
# DIFFERENT value (Dashboard -> Webhooks -> HTTP webhook signing key) and the two
# are not interchangeable - signing a webhook check with the API key produces a
# signature that never verifies. MAILGUN_ENDPOINT is a bare host; a scheme on it
# is normalised away in config/services.php rather than trusted.
MAILGUN_DOMAIN=
MAILGUN_SECRET=
MAILGUN_ENDPOINT=api.mailgun.net
MAILGUN_WEBHOOK_SIGNING_KEY=

# Cloudflare Turnstile on the résumé form. Both keys or neither: with the secret
# unset the challenge is skipped end to end - no widget, no verification, and a
# null turnstile_success on the row - which is how local and CI run without them.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_PORT=5180

OCTANE_SERVER=frankenphp
OCTANE_HTTPS=false

# Cloudflare analytics for the /dashboard panel.
# site_tag is NOT the beacon's siteToken and NOT the zone id - read it from
# GET /accounts/{id}/rum/site_info/list and pick the row whose
# ruleset.zone_name matches this site. The token needs three permissions:
# Account Analytics:Read, Account Settings:Read, Zone Analytics:Read.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_WEB_ANALYTICS_SITE_TAG=
CLOUDFLARE_ZONE_ID=

SENTRY_API_TOKEN=
SENTRY_RELEASE_TOKEN=
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_ORGANIZATION=
SENTRY_PROJECT=
SENTRY_API_URL=https://us.sentry.io/api/0
SENTRY_MONTHLY_ERROR_QUOTA=5000